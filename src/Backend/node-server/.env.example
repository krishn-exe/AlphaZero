PORT=5000
DATABASE_URL=postgresql://postgres:postgres@db:5432/landslide_db?schema=public
AIML_API_KEY=aiml_shared_secret_key

# Email SMTP Configuration (Gmail)
# For Gmail: Use an App Password (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=your_email@gmail.com

# Firebase Admin Service Account (for push notifications)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
