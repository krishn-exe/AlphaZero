// Prisma schema — heatmap-only slice
// Requires PostGIS extension enabled on your Postgres DB:
//   CREATE EXTENSION IF NOT EXISTS postgis;

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per district (or grid cell later) — this is what powers the heatmap.
// NOTE ON DATA REALNESS: every District row holds DEMO/PLACEHOLDER data.
// The only real, model-computed scores in this system live on City rows
// (see below) for the two pilot cities — Aizawl and Shillong.
model District {
  id          Int      @id @default(autoincrement())
  name        String
  state       String
  // Geometry stored as GeoJSON text for now (simplest path to ship the heatmap fast).
  // Prisma doesn't have native PostGIS geometry support, so we store the boundary
  // as a GeoJSON string and parse it in the controller. Good enough for MVP.
  boundaryGeoJson String  @map("boundary_geojson")
  // Center point, used for simpler marker-based heatmaps if you skip polygons
  centerLat   Float    @map("center_lat")
  centerLng   Float    @map("center_lng")

  riskScore   Float     @default(0) @map("risk_score") // 0-100, DEMO data for all districts
  riskLevel   String    @default("low") @map("risk_level") // low | medium | high | severe
  rainfall    Float     @default(0) // dummy district-wise rainfall data in mm
  computedAt  DateTime? @map("computed_at") // when AIML's model actually produced this score (not row-update time)
  lastUpdated DateTime  @default(now()) @updatedAt @map("last_updated")

  cities      City[]
  subscribers Subscriber[]

  @@map("districts")
}

// City-level detail — ONLY populated for the pilot cities with a real
// AIML model behind them (currently Aizawl and Shillong). A district with
// no city rows just stays at district-level detail on the map; that's
// expected, not a bug.
model City {
  id          Int      @id @default(autoincrement())
  districtId  Int      @map("district_id")
  district    District @relation(fields: [districtId], references: [id])

  name        String
  boundaryGeoJson String @map("boundary_geojson")
  centerLat   Float    @map("center_lat")
  centerLng   Float    @map("center_lng")

  riskScore   Float     @default(0) @map("risk_score") // 0-100, REAL model output for pilot cities
  riskLevel   String    @default("low") @map("risk_level")
  rainfall    Float     @default(0) // dummy city-wise rainfall data in mm
  computedAt  DateTime? @map("computed_at")
  lastUpdated DateTime  @default(now()) @updatedAt @map("last_updated")

  @@map("cities")
}

// Early Warnings subscribers
model Subscriber {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  
  // OTP Verification
  otpHash         String?   @map("otp_hash")
  otpExpiresAt    DateTime? @map("otp_expires_at")
  
  // Preferences
  emailEnabled    Boolean   @default(true) @map("email_enabled")
  pushEnabled     Boolean   @default(false) @map("push_enabled")
  fcmToken        String?   @map("fcm_token")
  
  // District Association
  districtId      Int?      @map("district_id")
  district        District? @relation(fields: [districtId], references: [id])
  
  // Temporary Settings Session Token
  settingsToken   String?   @map("settings_token")
  tokenExpiresAt  DateTime? @map("token_expires_at")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([email])
  @@index([emailVerified, otpExpiresAt])
  @@map("subscribers")
}

// AI/ML Grid Predictions
model GridPrediction {
  id          Int      @id @default(autoincrement())
  latitude    Float
  longitude   Float
  riskRating  Float    @map("risk_rating") // 0 to 1
  computedAt  DateTime @map("computed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([latitude, longitude])
  @@map("grid_predictions")
}
