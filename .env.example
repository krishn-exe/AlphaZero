# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/landslide_db?schema=public"

# Shared secret AIML's pipeline sends as the x-api-key header on
# PUT /api/map/district/:id/risk and PUT /api/map/city/:id/risk.
# Generate a random string and share it with your AIML teammate privately
# (not in a group chat / not committed to git).
AIML_API_KEY=replace_this_with_a_long_random_string Save the file.
