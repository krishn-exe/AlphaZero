# ==============================================================================
# Bhu Rakshak — Unified Project Environment Configuration
# Put all your credentials here in a single file: AlphaZero/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Postgres / PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=landslide_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landslide_db?schema=public

# ------------------------------------------------------------------------------
# 2. Backend & AIML Shared Security
# ------------------------------------------------------------------------------
PORT=5000
PORT_HTTP=80
AIML_API_KEY=aiml_shared_secret_key

# ------------------------------------------------------------------------------
# 3. Email Alerts & OTP (Gmail SMTP)
# ------------------------------------------------------------------------------
# Generate 16-char App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM=your_email@gmail.com

# ------------------------------------------------------------------------------
# 4. Frontend & Web Push Notifications (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
# Vite uses VITE_ prefix to expose variables to browser client code
VITE_API_URL=http://localhost:5000
VITE_ARCGIS_API_KEY=

# Firebase Web App Config (Firebase Console -> Project Settings -> General -> Your apps -> Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Web Push VAPID Key (Project Settings -> Cloud Messaging -> Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
